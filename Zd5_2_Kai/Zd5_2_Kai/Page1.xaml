<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zd5_2_Kai.Page1"
             BackgroundColor="#2c3036">

    <ContentPage.Resources>
        <StyleSheet Source="/Styles/Pg1.css" />
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid Padding="30, 80, 30, 80" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Блок сверху -->
            <StackLayout Grid.Row="0" VerticalOptions="Start">
                <Label Text="Вход прошел успешно" 
                       StyleClass="success-title-dark" 
                       FontAttributes="Italic"
                       HorizontalOptions="Center" />
            </StackLayout>

            <!-- Блок в центре -->
            <StackLayout Grid.Row="1" Spacing="35" VerticalOptions="Center">
                <Label Text="Пользователь:" 
                       StyleClass="user-subtitle-dark" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Button x:Name="NameBtn" 
                        StyleClass="capsule-blue" 
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        Clicked="NameClick" />
            </StackLayout>

            <!-- Блок снизу -->
            <StackLayout Grid.Row="2" VerticalOptions="End">
                <Button Text="Настроить интерфейс" 
                        StyleClass="capsule-blue-outline" 
                        HorizontalOptions="Center"
                        Clicked="Page2Click" />
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>